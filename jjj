@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Kufi+Arabic:wght@400;500;600;700&display=swap');
@import 'tailwindcss';
@import 'tw-animate-css';
@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-popover-border: hsl(var(--popover-border));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --font-sans: var(--app-font-sans);
  --font-mono: var(--app-font-mono);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --background: 220 30% 5%;
  --foreground: 203 23% 89%;
  --border: 213 29% 16%;
  --input: 214 31% 12%;
  --card: 218 27% 8%;
  --card-foreground: 203 23% 89%;
  --card-border: 211 32% 19%;
  --popover: 218 27% 9%;
  --popover-foreground: 203 23% 89%;
  --popover-border: 211 32% 19%;
  --primary: 176 89% 45%;
  --primary-foreground: 220 30% 5%;
  --secondary: 216 25% 13%;
  --secondary-foreground: 202 24% 77%;
  --muted: 216 25% 12%;
  --muted-foreground: 209 16% 53%;
  --accent: 175 80% 38%;
  --accent-foreground: 203 23% 92%;
  --destructive: 353 68% 62%;
  --destructive-foreground: 220 30% 5%;
  --ring: 176 89% 45%;
  --radius: 1.15rem;
  --app-font-sans: 'Noto Kufi Arabic', system-ui, sans-serif;
  --app-font-mono: 'IBM Plex Mono', ui-monospace, monospace;
  --sidebar: 221 29% 7%;
  --sidebar-foreground: 203 23% 89%;
  --sidebar-border: 211 32% 15%;
  --sidebar-primary: 176 89% 45%;
  --sidebar-primary-foreground: 220 30% 5%;
  --sidebar-accent: 216 25% 13%;
  --sidebar-accent-foreground: 203 23% 89%;
  --sidebar-ring: 176 89% 45%;
  --elevate-1: rgba(255,255,255,.04);
  --elevate-2: rgba(255,255,255,.08);
}

.dark {
  --background: 220 30% 5%;
  --foreground: 203 23% 89%;
  --border: 213 29% 16%;
  --input: 214 31% 12%;
  --card: 218 27% 8%;
  --card-foreground: 203 23% 89%;
  --card-border: 211 32% 19%;
  --popover: 218 27% 9%;
  --popover-foreground: 203 23% 89%;
  --popover-border: 211 32% 19%;
  --primary: 176 89% 45%;
  --primary-foreground: 220 30% 5%;
  --secondary: 216 25% 13%;
  --secondary-foreground: 202 24% 77%;
  --muted: 216 25% 12%;
  --muted-foreground: 209 16% 53%;
  --accent: 175 80% 38%;
  --accent-foreground: 203 23% 92%;
  --destructive: 353 68% 62%;
  --destructive-foreground: 220 30% 5%;
  --input: 214 31% 15%;
  --ring: 176 89% 45%;
}

@layer base {
  * { @apply border-border; }
  html { background: hsl(var(--background)); }
  body {
    @apply font-sans antialiased bg-background text-foreground;
    margin: 0;
    min-width: 320px;
    font-size: 13px;
  }
  button, input { font: inherit; }
  button { cursor: pointer; }
}

@layer utilities {
  .hover-elevate { transition: background-color .18s ease, border-color .18s ease, transform .18s ease; }
  .hover-elevate:hover { background-color: var(--elevate-1); border-color: hsl(var(--primary) / .35); }
  .active-elevate:active { transform: translateY(1px); }
}

:root {
  --line: rgba(55, 206, 195, .15);
}

.app-frame {
  min-height: 100dvh;
  background:
    radial-gradient(circle at 12% -8%, rgba(17, 125, 130, .13), transparent 29rem),
    radial-gradient(circle at 100% 28%, rgba(25, 62, 80, .12), transparent 26rem),
    hsl(var(--background));
}
.top-bar {
  border-bottom: 1px solid rgba(84, 118, 130, .12);
  background: rgba(5, 12, 18, .84);
  backdrop-filter: blur(18px);
}
.page-shell { width: min(100%, 960px); margin: 0 auto; padding: 20px 16px 68px; }
.content-column { width: min(100%, 620px); margin: 0 auto; }
.brand-mark {
  width: 35px; height: 35px; border-radius: 12px;
  display: grid; place-items: center;
  background: hsl(var(--primary)); color: hsl(var(--primary-foreground));
  box-shadow: 0 7px 24px rgba(7, 218, 198, .16);
}
.brand-mark svg { width: 19px; height: 19px; stroke-width: 2.4; }
.eyebrow { color: hsl(var(--primary)); font-size: 10px; letter-spacing: .16em; font-family: var(--app-font-mono); text-transform: uppercase; }
.headline { font-size: clamp(22px, 5vw, 31px); line-height: 1.48; font-weight: 700; letter-spacing: -.04em; }
.subtle { color: hsl(var(--muted-foreground)); }
.panel {
  border: 1px solid rgba(90, 132, 145, .15);
  background: linear-gradient(180deg, rgba(15, 25, 35, .9), rgba(8, 15, 24, .94));
  border-radius: 22px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, .13);
}
.category-tabs {
  display: flex; align-items: center; gap: 4px; padding: 5px;
  border: 1px solid rgba(74, 119, 127, .12);
  border-radius: 18px; background: rgba(7, 15, 23, .65);
}
.category-tab {
  flex: 1; min-height: 38px; padding: 0 8px; border: 0;
  border-radius: 14px; color: hsl(var(--muted-foreground));
  background: transparent; font-size: 11px; transition: color .18s ease, background-color .18s ease, transform .18s ease;
}
.category-tab:hover { color: hsl(var(--foreground)); }
.category-tab[data-active="true"] { color: hsl(var(--primary-foreground)); background: hsl(var(--primary)); box-shadow: 0 6px 17px rgba(6, 211, 192, .15); }
.timer-row {
  position: relative; overflow: hidden; min-height: 62px; padding: 17px 16px 12px;
  border: 1px solid rgba(62, 116, 122, .35); border-radius: 22px;
  background: linear-gradient(115deg, rgba(11, 20, 31, .98), rgba(11, 17, 27, .9));
  animation: slide-in .34s both; transition: border-color .18s ease, transform .18s ease, background-color .18s ease;
}
.timer-row:hover { border-color: rgba(24, 208, 193, .55); transform: translateY(-1px); }
.timer-row::before {
  content: ''; position: absolute; top: -1px; right: 0; height: 5px; width: var(--progress, 22%);
  border-radius: 0 22px 0 8px; background: hsl(var(--primary));
  transition: width .7s linear;
}
.timer-row.expired { opacity: .52; border-color: rgba(81, 100, 107, .28); }
.timer-row.expired::before { background: hsl(var(--muted-foreground)); width: 4%; }
.timer-row.same-time { border-color: hsl(var(--destructive) / .7); }
.timer-row.same-time .timer-name, .timer-row.same-time .timer-count { color: hsl(var(--destructive)); }
.timer-row.same-time::before { background: hsl(var(--destructive)); }
.timer-name { font-size: 13px; font-weight: 700; color: hsl(var(--foreground)); }
.timer-count { direction: ltr; color: hsl(var(--foreground)); font-family: var(--app-font-mono); font-size: 15px; font-weight: 600; letter-spacing: .03em; white-space: nowrap; }
.timer-count strong { color: hsl(var(--primary)); font-size: 10px; font-family: var(--app-font-sans); font-weight: 500; margin-inline-start: 3px; }
.timer-meta { direction: rtl; color: hsl(var(--primary) / .72); font-family: var(--app-font-mono); font-size: 10px; white-space: nowrap; }
.pill {
  display: inline-flex; align-items: center; gap: 5px; border-radius: 999px;
  padding: 5px 10px; border: 1px solid rgba(75, 135, 140, .2);
  color: hsl(var(--muted-foreground)); background: rgba(8, 18, 26, .64); font-size: 10px;
}
.icon-button {
  width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center;
  color: hsl(var(--muted-foreground)); background: transparent; border: 1px solid transparent;
  transition: color .18s ease, background-color .18s ease, border-color .18s ease, transform .18s ease;
}
.icon-button:hover { color: hsl(var(--foreground)); border-color: rgba(72, 132, 137, .28); background: rgba(31, 50, 58, .54); }
.icon-button.danger:hover { color: hsl(var(--destructive)); border-color: hsl(var(--destructive) / .28); }
.primary-button {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 40px; padding: 0 17px; border: 0; border-radius: 999px;
  background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); font-weight: 700; font-size: 12px;
  box-shadow: 0 9px 25px rgba(5, 207, 190, .12); transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
}
.primary-button:hover { filter: brightness(1.08); box-shadow: 0 11px 30px rgba(5, 207, 190, .2); transform: translateY(-1px); }
.secondary-button {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 40px; padding: 0 15px; border: 1px solid rgba(71, 124, 132, .25); border-radius: 999px;
  background: rgba(24, 39, 48, .54); color: hsl(var(--foreground)); font-size: 11px; transition: background-color .18s ease, border-color .18s ease;
}
.secondary-button:hover { background: rgba(33, 59, 64, .7); border-color: rgba(25, 207, 192, .42); }
.text-button { border: 0; background: transparent; color: hsl(var(--muted-foreground)); font-size: 11px; padding: 7px 4px; }
.text-button:hover { color: hsl(var(--primary)); }
.modal-backdrop { position: fixed; inset: 0; z-index: 50; display: grid; place-items: end center; padding: 14px; background: rgba(1, 5, 8, .72); backdrop-filter: blur(8px); animation: fade-in .2s ease; }
.modal {
  width: min(100%, 480px); max-height: calc(100dvh - 28px); overflow-y: auto; padding: 20px;
  border: 1px solid rgba(84, 150, 153, .3); border-radius: 26px;
  background: hsl(218 28% 9%); box-shadow: 0 25px 80px rgba(0,0,0,.45); animation: sheet-in .3s cubic-bezier(.2,.8,.2,1);
}
.field-label { display: block; margin-bottom: 7px; color: hsl(var(--muted-foreground)); font-size: 10px; }
.field-input {
  width: 100%; min-height: 43px; padding: 0 12px; border-radius: 13px;
  border: 1px solid rgba(76, 121, 130, .24); outline: none; color: hsl(var(--foreground));
  background: rgba(6, 15, 23, .86); font-size: 12px; transition: border-color .18s ease, box-shadow .18s ease;
}
.field-input:focus { border-color: hsl(var(--primary) / .7); box-shadow: 0 0 0 3px hsl(var(--primary) / .1); }
.stepper { display: grid; grid-template-columns: 34px 1fr 34px; align-items: center; gap: 6px; }
.stepper-button { width: 34px; height: 34px; border: 1px solid rgba(75, 125, 130, .25); border-radius: 10px; color: hsl(var(--primary)); background: rgba(16, 34, 40, .8); }
.stepper-button:hover { background: rgba(22, 67, 70, .8); }
.stepper-value { text-align: center; color: hsl(var(--foreground)); font-family: var(--app-font-mono); font-size: 15px; }
.stepper-input { width: 100%; border: 0; outline: 0; background: transparent; text-align: center; }
.stepper-input::-webkit-inner-spin-button, .stepper-input::-webkit-outer-spin-button { appearance: none; margin: 0; }
.toast-note { position: fixed; right: 16px; bottom: 20px; z-index: 70; padding: 11px 15px; border: 1px solid hsl(var(--primary) / .4); border-radius: 13px; background: hsl(218 27% 10%); color: hsl(var(--foreground)); box-shadow: 0 12px 30px rgba(0,0,0,.3); animation: toast-in .25s ease; font-size: 11px; }
.skeleton { border-radius: 11px; background: linear-gradient(100deg, rgba(24,40,48,.55), rgba(54,76,80,.48), rgba(24,40,48,.55)); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
.empty-state { display: grid; place-items: center; min-height: 230px; padding: 24px; border: 1px dashed rgba(80, 128, 133, .26); border-radius: 22px; text-align: center; }
.empty-icon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 16px; color: hsl(var(--primary)); background: hsl(var(--primary) / .1); }
.share-hero { padding: 26px 22px 24px; border: 1px solid rgba(83, 143, 150, .2); border-radius: 25px; background: linear-gradient(135deg, rgba(14, 38, 43, .76), rgba(8, 18, 29, .88)); }
.public-count { font-family: var(--app-font-mono); font-size: clamp(40px, 13vw, 76px); line-height: 1; letter-spacing: -.08em; color: hsl(var(--primary)); text-shadow: 0 0 32px rgba(9, 215, 193, .12); }
.public-unit { color: hsl(var(--muted-foreground)); font-size: 11px; }
.page-footer { border-top: 1px solid rgba(81, 118, 124, .12); color: hsl(var(--muted-foreground)); font-size: 10px; line-height: 2; }
.list-drawer {
  position: fixed; inset: 0 auto 0 0; z-index: 40; width: min(86vw, 300px); padding: 20px 15px;
  background: hsl(221 29% 8%); border-right: 1px solid rgba(77, 127, 133, .22); box-shadow: 18px 0 45px rgba(0,0,0,.26);
  animation: drawer-in .28s ease;
}
.list-item { width: 100%; display: flex; align-items: center; gap: 10px; text-align: right; padding: 12px 11px; border: 1px solid transparent; border-radius: 14px; color: hsl(var(--muted-foreground)); background: transparent; }
.list-item:hover, .list-item[data-active="true"] { color: hsl(var(--foreground)); background: rgba(24,48,55,.72); border-color: rgba(67,132,137,.22); }
.list-item[data-active="true"] .list-dot { background: hsl(var(--primary)); box-shadow: 0 0 0 4px hsl(var(--primary) / .1); }
.list-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: hsl(var(--muted-foreground)); }
.rotate-icon { animation: rotate-slow 5s linear infinite; }

@keyframes fade-in { from { opacity: 0 } to { opacity: 1 } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(24px) } to { opacity: 1; transform: translateY(0) } }
@keyframes drawer-in { from { transform: translateX(-100%) } to { transform: translateX(0) } }
@keyframes slide-in { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: translateY(0) } }
@keyframes shimmer { from { background-position: 200% 0 } to { background-position: -200% 0 } }
@keyframes toast-in { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: translateY(0) } }
@keyframes rotate-slow { to { transform: rotate(360deg) } }

@media (min-width: 768px) {
  .page-shell { padding: 34px 24px 90px; }
  .modal-backdrop { place-items: center; }
  .top-bar-inner { width: min(100%, 960px); margin: 0 auto; }
}
@media (max-width: 470px) {
  .page-shell { padding-inline: 12px; }
  .timer-row { padding-inline: 12px; }
  .timer-count { font-size: 14px; }
  .category-tab { font-size: 10px; padding-inline: 3px; }
}
